{
  "name": "tideline-beach-experience",
  "version": "0.49.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node scripts/run-unit-checks.mjs",
    "test:production": "node scripts/production-path-check.mjs",
    "test:water-quality": "node scripts/water-quality-check.mjs",
    "check:assets": "node scripts/asset-integrity-check.mjs",
    "fetch:water": "node scripts/fetch-water-assets.mjs",
    "dev": "vite --host 0.0.0.0",
    "generate:characters": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-chibi-models.ps1",
    "build": "vite build && node scripts/prepare-dist.mjs",
    "export:web": "npm run build && node scripts/export-web.mjs",
    "start": "node scripts/local-server.mjs --root dist --port 5175 --open",
    "stop": "node scripts/local-server.mjs --stop",
    "status": "node scripts/local-server.mjs --status",
    "preview": "vite preview --host 0.0.0.0",
    "test:server": "node scripts/local-server-check.mjs",
    "test:gpu": "node scripts/gpu-timer-check.mjs",
    "test:audio": "node scripts/footstep-audio-check.mjs",
    "test:bookmarks": "node scripts/camera-bookmarks-check.mjs",
    "test:swell": "node scripts/ocean-swell-check.mjs",
    "test:bloom": "node scripts/bloom-check.mjs",
    "test:wind": "node scripts/coastal-wind-check.mjs",
    "test:cloud": "node scripts/cloud-quality-check.mjs",
    "test:reflection": "node scripts/water-reflection-quality-check.mjs",
    "test:normal": "node scripts/water-normal-quality-check.mjs",
    "test:moon": "node scripts/moon-quality-check.mjs",
    "test:star": "node scripts/star-quality-check.mjs",
    "test:visibility": "node scripts/atmosphere-visibility-check.mjs",
    "test:rain-lifecycle": "node scripts/rain-lifecycle-check.mjs",
    "test:celestial": "node scripts/celestial-resource-check.mjs",
    "test:discovery-lifecycle": "node scripts/discovery-resource-check.mjs",
    "test:billiards": "node scripts/beach-billiards-check.mjs",
    "test:billiards-input": "node scripts/billiards-input-check.mjs",
    "test:billiards-presentation": "node scripts/billiards-presentation-check.mjs",
    "test:models": "node scripts/scene-modeling-check.mjs",
    "test:coastal": "node scripts/coastal-assets-check.mjs",
    "test:ocean-npc": "node scripts/ocean-npc-check.mjs",
    "test:npc-quality": "node scripts/npc-quality-check.mjs",
    "test:water-layout": "node scripts/water-layout-check.mjs",
    "test:shore-detail": "node scripts/shore-detail-check.mjs",
    "test:swash": "node scripts/shore-swash-check.mjs",
    "test:boundary": "node scripts/boundary-check.mjs",
    "test:street": "node scripts/street-check.mjs",
    "fetch:street": "node scripts/fetch-coastal-assets.mjs --street",
    "prepare:street": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-coastal-assets.ps1 -Street",
    "prepare:small-props": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-coastal-assets.ps1 -Details",
    "test:living-coast": "node scripts/living-coast-check.mjs",
    "prepare:npcs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-npc-assets.ps1",
    "prepare:crowd": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-npc-assets.ps1 -CrowdOnly",
    "fetch:coastal": "node scripts/fetch-coastal-assets.mjs",
    "prepare:coastal": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-coastal-assets.ps1",
    "test:characters": "node scripts/character-system-check.mjs",
    "test:visual": "node scripts/visual-check.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "cannon-es": "0.20.0",
    "lucide": "1.26.0",
    "three": "0.160.0"
  },
  "devDependencies": {
    "playwright-core": "1.61.1",
    "pngjs": "7.0.0",
    "vite": "7.3.6"
  }
}
